<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UltimateWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UltimateWinUI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <TextBlock Text="UltimateWinUI" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="FR33THY Ultimate library" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search tweaks"
                                QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="StatusBar" Grid.Row="0" IsOpen="False" Margin="24,8,24,0" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
